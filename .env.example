ANTHROPIC_API_KEY=
# Channel auth (comments, sandbox checkout, HITL prompts) is Connect-managed — provisioned in
# Task 17 via `vercel connect create github`, not an env var. GITHUB_PR_TOKEN below is a
# separate, narrowly-scoped PAT (repo scope, pull-request write) used only by the open_pr tool
# (Task 14), since a ToolContext has no ctx.github the way a channel dispatch context does.
GITHUB_PR_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=vikunja
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Voyage AI key used by the search_codebase_semantic tool to embed the query at runtime
# (https://dashboard.voyageai.com). The prebuilt index in agent/lib/code-intelligence.sqlite
# already contains the document embeddings, but the *query* still has to be embedded on
# each search, so without this key search_codebase_semantic degrades to a "not configured;
# fall back to grep/read" no-op. Must be set on the deployment, not just locally.
VOYAGE_API_KEY=
# Optional: raise these once the Voyage account has a payment method on file. An account
# without one is capped at 3 requests/min and 10,000 tokens/min, which is what the indexer
# assumes by default; standard limits are 2000 / 3000000.
VOYAGE_RPM=
VOYAGE_TPM=
